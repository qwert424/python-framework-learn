# web 服务配置
WEB_APP_NAME=web服务

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=learn_db
DB_USER=admin
DB_PASSWORD=123123

# 其他配置
# 跨域白名单，多个来源用逗号分隔，* 表示允许所有
WEB_CORS_ORIGINS=*
# 允许前端读取的响应头，多个用逗号分隔
WEB_CORS_EXPOSE_HEADERS=X-Process-Time
# JWT 密钥
WEB_JWT_SECRET_KEY=8f7e1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5

# 阿里云 OSS 配置（文件上传用）
# 例如 oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
# RAM 用户的 AccessKey ID
OSS_ACCESS_KEY_ID=
# RAM 用户的 AccessKey Secret
OSS_ACCESS_KEY_SECRET=
# Bucket 名称
OSS_BUCKET_NAME=
